# Browser requests stay same-origin and are proxied through Next.js.
NEXT_PUBLIC_API_BASE_URL=/api

# Server-only rewrite target. The NestJS backend defaults to port 3000.
BACKEND_API_URL=http://localhost:3000

# Configure the backend separately with FRONTEND_URL=http://localhost:3001.
# Production requires HTTPS and COOKIE_SECURE=true on the backend.
# Rebuild Next.js after changing the rewrite target for a production build.
