NODE_ENV=development
PORT=3000
MONGODB_URI=
# Optional resolver override for Node environments whose local DNS proxy cannot resolve Atlas SRV records.
MONGODB_DNS_SERVERS=
# Optional standard multi-host fallback when a network blocks Atlas SRV/TXT queries.
MONGODB_DIRECT_HOSTS=
MONGODB_REPLICA_SET=
JWT_ACCESS_SECRET=
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=

# Configure both Stripe TEST credentials locally; never commit their values.
# STRIPE_SECRET_KEY starts with sk_test_. Obtain it from the Stripe test dashboard.
# STRIPE_WEBHOOK_SECRET starts with whsec_. `npm run stripe:listen` prints a local
# listener secret; deployed environments use the signing secret for their endpoint.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
